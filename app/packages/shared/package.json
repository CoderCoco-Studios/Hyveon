{
  "name": "@hyveon/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./gameServerValidator": {
      "types": "./dist/gameServerValidator.d.ts",
      "default": "./dist/gameServerValidator.js"
    },
    "./envTokens": {
      "types": "./dist/envTokens.d.ts",
      "default": "./dist/envTokens.js"
    },
    "./secrets/secretsStore": {
      "types": "./dist/secrets/secretsStore.d.ts",
      "default": "./dist/secrets/secretsStore.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.1095.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
}
