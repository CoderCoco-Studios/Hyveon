# App runtime
app/server_config.json
app/.iam-bootstrap-dev

# Node.js
node_modules/
app/packages/*/dist/
app/packages/lambda/*/dist/
app/**/*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code — developer-local tool permissions. The shared equivalent
# lives at .claude/settings.json (commit that instead if you want the
# allowlist shared across the team).
.claude/settings.local.json
.claude/worktrees/
.worktrees/

# Plyflow — developer-local run logs
.plyflow/

# Playwright artifacts (traces, videos, screenshots) and HTML report.
app/packages/web/test-results/
app/packages/web/playwright-report/
app/packages/web/playwright/.cache/
app/packages/web/dist-integration/

.make

# Vitest coverage output
app/coverage/

# electron-vite build output (main/preload/renderer bundles)
out/

# electron-builder packaged artifacts
release/

# legacy pre-rename marker dir — ignored during the .gsd -> .hyveon compat window
.gsd/

# Superpowers subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/
