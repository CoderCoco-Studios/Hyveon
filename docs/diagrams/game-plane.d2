direction: right

operator: "Operator's laptop" {
  dashboard: "React dashboard\n(renderer)"
  api: "desktop-main\n(Nest.js, Electron main process)"
  dashboard -> api: "Electron IPC\n(window.hyveon)"
}

config: "deployment-config.json\n(S3 configuration bucket,\nread via RemoteFileStore)" {
  shape: document
}

aws: "AWS account" {
  ecs: "ECS Fargate tasks\n{game}-server\n(+ Caddy sidecar for HTTPS games)"
  efs: "EFS\nper-game access points" {
    shape: cylinder
  }
  ddb: "DynamoDB" {
    shape: cylinder
  }
  sm: "Secrets Manager" {
    shape: cylinder
  }
  cw: "CloudWatch logs" {
    shape: cylinder
  }

  ecs -> efs: "nfs"
}

player: "Player" {
  shape: person
}

operator.api -> config: "read"
operator.api -> aws.ecs: "RunTask / StopTask / DescribeTasks"
operator.api -> aws.ddb: "put CONFIG#discord"
operator.api -> aws.sm: "put bot-token / public-key"
operator.api -> aws.cw: "tail logs"
player -> aws.ecs: "UDP / TCP / HTTPS\n(Caddy sidecar terminates TLS)"
