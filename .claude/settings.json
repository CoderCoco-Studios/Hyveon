{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-superpowers-paths.ts\"",
            "statusMessage": "Checking brainstorm/plan output path against routing rule..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-checkout.ts\"",
            "statusMessage": "Checking edit is not on the main checkout..."
          }
        ]
      },
      {
        "matcher": "EnterWorktree|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-redirect-to-pane.ts\"",
            "statusMessage": "Checking worktree creation goes through Pane..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-push-sync.ts\"",
            "statusMessage": "Checking branch is up to date before push..."
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || echo 'graphify not installed — skipping guard' >&2"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || echo 'graphify not installed — skipping guard' >&2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-branch-sync-drift.ts\"",
            "statusMessage": "Checking branch sync status against base branch..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-branch-sync-drift.ts\"",
            "statusMessage": "Checking branch sync status against base branch..."
          }
        ]
      }
    ]
  }
}